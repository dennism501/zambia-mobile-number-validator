{
  "name": "zambian-mobile-validator",
  "version": "1.0.0",
  "description": "Validate Zambian mobile numbers and detect the network (Airtel, MTN, Zamtel).",
  "license": "MIT",
  "author": "Dennis Mubamba <mubambadennis@gmail.com>",
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/index.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "zambia",
    "mobile",
    "phone",
    "validator",
    "airtel",
    "mtn",
    "zamtel"
  ]
}
